# Sucullu Koyu kamera relay ayarlari — bu dosyayi "config.env" adiyla kopyalayip doldurun.
# Bu dosya YALNIZCA koy bilgisayarinda kalir; kimseyle paylasmayin, Git'e koymayin.

# Reolink NVR (yerel ag)
NVR_HOST=192.168.1.113
NVR_PORT=554
NVR_USER=
NVR_PASSWORD=

# Sunucu (Coolify MediaMTX SRT girisi)
SRT_HOST=46.225.123.167
SRT_PORT=8890
# Sunucudaki MTX_PATHDEFAULTS_SRTPUBLISHPASSPHRASE ile AYNI deger olmali.
SRT_PASSPHRASE=

# --- Opsiyonel ayarlar (bos birakilirsa varsayilan kullanilir) ---

# Video modu: transcode (varsayilan) | copy | auto
#   transcode : her zaman H.264'e yeniden kodlar. NVR substream'inin DTS
#               degerleri HLS icin bozuk oldugundan saha varsayilani budur.
#   copy      : yeniden kodlamaz (yalnizca DTS'i saglam kaynaklarda calisir).
#   auto      : kaynak H.264 ise copy, degilse transcode.
VIDEO_MODE=transcode

# Ses modu: off (varsayilan) | aac
#   NVR ses kanali non-monotonic DTS uretiyor; yayin video-only tutulur.
AUDIO_MODE=off

# Preflight testinin kullanacagi kamera (bos = ilk ERISILEBILIR kanal secilir).
# Ornek: PREFLIGHT_CAMERA=kamera6
PREFLIGHT_CAMERA=
